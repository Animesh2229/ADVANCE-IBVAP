# IBVAP Environment Variables
# Copy this file to .env and fill real values
# NEVER commit .env file

# Database
DATABASE_URL=postgresql+asyncpg://ibvap:CHANGE_THIS_PASSWORD@localhost:5432/ibvap

# Security
# REQUIRED in production (ENVIRONMENT=production): >= 32 characters or Central refuses to start
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Edge <-> Central (MUST be identical on every Edge box and Central)
# Generate Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EDGE_FERNET_KEY=
EDGE_HMAC_SECRET=CHANGE_THIS_LONG_RANDOM_HMAC_SECRET

# Admin (used only in create_admin.py) — first login forces password change
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
ADMIN_EMAIL=admin@yourdomain.local

# CORS (comma separated frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional
FCM_SERVER_KEY=
C2_WEBHOOK_URL=
C2_WEBHOOK_TIMEOUT=5
# Optional Redis for multi-worker rate limiting (leave empty = in-memory)
REDIS_URL=
ALERT_RATE_LIMIT_PER_CAMERA=30
ALERT_RATE_WINDOW_SECONDS=60
ENVIRONMENT=development
