# IBVAP Environment Variables
# Copy this file to .env and fill real values
# NEVER commit .env file

DATABASE_URL=postgresql+asyncpg://ibvap:CHANGE_THIS_PASSWORD@localhost:5432/ibvap
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=480
EDGE_FERNET_KEY=
EDGE_HMAC_SECRET=CHANGE_THIS_LONG_RANDOM_HMAC_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
ADMIN_EMAIL=admin@yourdomain.local
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FCM_SERVER_KEY=
C2_WEBHOOK_URL=
C2_WEBHOOK_TIMEOUT=5
# Required for multi-worker production scale (rate-limit, replay, WS fanout)
REDIS_URL=
ALERT_RATE_LIMIT_PER_CAMERA=30
ALERT_RATE_WINDOW_SECONDS=60
ALERT_REPLAY_TTL_SECONDS=300
FUSION_STATE_PATH=/var/lib/ibvap/fusion_state.json
# Non-watchlist face embeddings auto-purged after this many hours
FACE_EMBEDDING_TTL_HOURS=72
ENVIRONMENT=development
